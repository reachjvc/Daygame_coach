# Training data (large local assets)
/data/*
# ...except the eval prompts, which the running app reads at request time.
# 156K. Excluding them made every production build fail with a bare ENOENT.
!/data/woman-responses/
/data/woman-responses/*
!/data/woman-responses/prompts/
/batch-views
training-data
training-data/**
!training-data/
!training-data/sources.txt
data/token/huggingface

# Sensitive: YouTube cookies export (never commit)
www.youtube.com_cookies.txt

# Local backups (never commit)
training-data.local-backup-*

# Windows alternate data stream artifacts
*:Zone.Identifier

# Python
.venv/
venv/
env/
ENV/
__pycache__/
*.py[cod]
*.pyc
*.class

# Python caches
.cache/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Local dependency clones
/whisper.cpp/
/LivePortrait/
/SadTalker/

# Test artifacts
playwright-report/
test-results/
tests/integration/.test-connection.json
tests/e2e/.auth/
# `npm test -- --coverage` regenerates this. 57 generated HTML files were
# committed once and then went stale; the report is never read from git.
coverage/

# Playwright MCP screenshots
.playwright-mcp/
*.png
# The PWA icons must ship: app/manifest.ts and public/sw.js reference them, and
# a clean checkout without them means no "Add to Home Screen" on Chrome/Android.
!public/icon-*.png
!public/apple-icon.png

# Database backups — real data, never committed
backups/
