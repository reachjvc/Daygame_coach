#!/bin/sh

# Type errors may only go down. See scripts/typecheck-ratchet.mjs.
#
# This checks the WORKING TREE, not the commits being pushed — uncommitted work
# counts, committed work you have since changed does not. Stashing to fix that is
# forbidden here (a second agent shares this checkout), so this is a fast local
# warning and CI is the gate: .github/workflows/ci.yml runs the same script on
# the pushed commit.
echo "🔎 Type-check ratchet (working tree)..."
node scripts/typecheck-ratchet.mjs || exit 1

# Lint errors may only go down. Same bargain, same caveat: this measures the
# working tree and CI measures the pushed commit. See scripts/lint-ratchet.mjs.
echo "🔎 Lint ratchet (working tree)..."
node scripts/lint-ratchet.mjs || exit 1
