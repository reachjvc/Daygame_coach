#!/bin/sh

echo "🔍 Running pre-commit checks..."

# Run the unit tests that matter for what is staged (D2 of
# Plans/tests-green-and-fast.md). CI still runs every test.
echo "📦 Running unit tests..."
staged=$(git diff --cached --name-only --diff-filter=ACMR)
# Config, setup or workflow changes can break any test: run all of them.
if echo "$staged" | grep -qE '^(vitest\.config\.ts|tests/setup\.ts|tests/__mocks__/|package(-lock)?\.json|tsconfig\.json|\.github/|docs/testing/|playwright\.config\.ts)'; then
  npm test -- --reporter=dot || { echo "❌ Unit tests failed. Commit aborted."; exit 1; }
else
  code=$(echo "$staged" | grep -E '\.(ts|tsx|mjs|js)$')
  if [ -n "$code" ]; then
    npx vitest related --run --reporter=dot $code || { echo "❌ Unit tests failed. Commit aborted."; exit 1; }
  fi
fi

# A doc-changelog check used to live here. It demanded today's date as
# DD-MM-YYYY in every modified doc, citing a CLAUDE.md rule ("Add entry to top
# of any doc you modify") that no longer exists — and the project writes dates
# as YYYY-MM-DD, so it could not be satisfied by writing the entry it asked for.
# It warned on essentially every doc edit and blocked nothing, which is how this
# repo already taught itself to ignore a red tick (see the 492-lint-error story
# in .github/workflows/ci.yml). Removed 2026-09-22. If doc freshness is worth
# enforcing, it needs a check somebody can pass.

echo "✅ Pre-commit checks passed!"
