#!/bin/sh

echo "🔍 Running pre-commit checks..."

# Run unit tests (includes architecture compliance)
echo "📦 Running unit tests..."
npm test -- --reporter=dot
if [ $? -ne 0 ]; then
  echo "❌ Unit tests failed. Commit aborted."
  exit 1
fi

# A doc-changelog check used to live here. It demanded today's date as
# DD-MM-YYYY in every modified doc, citing a CLAUDE.md rule ("Add entry to top
# of any doc you modify") that no longer exists — and the project writes dates
# as YYYY-MM-DD, so it could not be satisfied by writing the entry it asked for.
# It warned on essentially every doc edit and blocked nothing, which is how this
# repo already taught itself to ignore a red tick (see the 492-lint-error story
# in .github/workflows/ci.yml). Removed 2026-09-22. If doc freshness is worth
# enforcing, it needs a check somebody can pass.

echo "✅ Pre-commit checks passed!"
